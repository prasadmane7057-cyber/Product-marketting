# NovaMarket Server Environment Variables
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL for production, SQLite for local testing)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/novamarket?schema=public"

# JSON Web Token Secret
JWT_SECRET="replace_with_a_long_random_secure_secret_string"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:5173"

# Cloudinary Storage (Optional, leaves empty for secure local disk upload storage)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Razorpay Test / Live Keys
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"

# SMTP Mail Server for Order Confirmations and Marketing
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your_smtp_password"
FROM_EMAIL="orders@yourdomain.com"
